diff --git a/packages/components/src/components/Checkbox/Checkbox.module.css b/packages/components/src/components/Checkbox/Checkbox.module.css
new file mode 100644
index 0000000..8e053db
--- /dev/null
+++ b/packages/components/src/components/Checkbox/Checkbox.module.css
@@ -0,0 +1,71 @@
+/* label.root (not .root): the root renders through <Text as="label">, whose
+   single-class .text/.body-default styles this must outrank regardless of
+   stylesheet order. */
+label.root {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--ds-space-inline-sm);
+  color: var(--ds-color-text-default);
+  cursor: pointer;
+}
+
+label.disabled {
+  color: var(--ds-color-text-disabled);
+  cursor: not-allowed;
+}
+
+.control {
+  position: relative;
+  display: inline-flex;
+  flex-shrink: 0;
+  width: var(--ds-size-300);
+  height: var(--ds-size-300);
+  color: var(--ds-color-icon-inverted-default);
+}
+
+.input {
+  appearance: none;
+  margin: 0;
+  width: 100%;
+  height: 100%;
+  background: var(--ds-color-background-input);
+  border: var(--ds-size-025) solid var(--ds-color-border-input-default);
+  border-radius: var(--ds-border-radius-xs);
+  cursor: inherit;
+  transition: background 120ms ease, border-color 120ms ease;
+}
+
+.input:hover:not(:disabled) {
+  border-color: var(--ds-color-border-input-hover);
+}
+
+.input:checked {
+  background: var(--ds-color-background-button-accent-default);
+  border-color: var(--ds-color-background-button-accent-default);
+}
+
+.input:checked:hover:not(:disabled) {
+  background: var(--ds-color-background-button-accent-hover);
+  border-color: var(--ds-color-background-button-accent-hover);
+}
+
+.input:disabled {
+  border-color: var(--ds-color-border-disabled);
+}
+
+.input:checked:disabled {
+  background: var(--ds-color-background-disabled);
+  border-color: var(--ds-color-background-disabled);
+}
+
+.check {
+  position: absolute;
+  inset: 0;
+  margin: auto;
+  pointer-events: none;
+  visibility: hidden;
+}
+
+.input:checked + .check {
+  visibility: visible;
+}
