+    "name": "Accordion",
+    "category": "molecule",
+    "type": "interactive",
+    "status": "beta",
+    "description": "A vertical list of collapsible sections (Accordion.Item). Each section has a header button with a title, an optional subtitle and a chevron, inside a heading of the page's outline (h3 by default, headingLevel on the root). Activating the header shows or hides the section's content. Sections open independently — several can be open at once — and each is uncontrolled (defaultOpen) or controlled (open + onOpenChange). Used for course curricula and FAQs."
+  },
+  "usage": {
+    "keywords": [
+      "accordion",
+      "collapsible",
+      "disclosure",
+      "expand",
+      "collapse",
+      "faq",
+      "curriculum",
+      "modules",
+      "syllabus",
+      "sections"
+    ],
+    "when": [
+      "Listing course modules where each can be expanded to read its description",
+      "An FAQ where each question reveals its answer",
+      "Pass subtitle for a secondary line under the title (e.g. a module's duration '4 hours, 30min')",
+      "Set headingLevel on Accordion so section titles sit one level below the surrounding section heading (default 3, under an h2 section)",
+      "Use defaultOpen for a section that starts open; use open + onOpenChange when the app needs to drive or track the open state"
+    ],
+    "patterns": [
+      {
+        "name": "course-curriculum",
+        "description": "A course page's curriculum: one item per module, subtitle carries the module duration, content is the module description. Story: Default.",
+        "tree": "Box(as=section, aria-labelledby) > [Heading(as=h2), Accordion(headingLevel=3) > [Accordion.Item(title, subtitle) > Text, ...]]"
+      },
+      {
+        "name": "faq",
+        "description": "Question/answer list without subtitles. Story: WithoutSubtitle.",
