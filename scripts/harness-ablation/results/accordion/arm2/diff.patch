@@ -0,0 +1,52 @@
+.root {
+  display: flex;
+  flex-direction: column;
+}
+
+.item {
+  position: relative;
+  border-block-end: 1px solid var(--ds-color-border-default);
+}
+
+.itemOpen {
+  background: var(--ds-color-background-container-elevated);
+}
+
+.header {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
