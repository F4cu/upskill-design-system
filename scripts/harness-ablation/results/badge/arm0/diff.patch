+.badge {
+  display: inline-flex;
+  align-items: center;
+  max-width: 100%;
+  padding-block: var(--ds-space-inset-xxs);
+  padding-inline: var(--ds-space-inset-sm);
+  border: 1px solid var(--ds-color-border-subtle);
+  border-radius: var(--ds-border-radius-sm);
+  color: var(--ds-color-text-subtle);
+  font-family: var(--ds-font-family-body);
+  font-size: var(--ds-font-size-label);
+  font-weight: var(--ds-font-weight-regular);
+  line-height: var(--ds-font-line-height-default);
+  white-space: nowrap;
+}
+
+.bordered {
+  background: transparent;
+}
+
+/* The alpha border sits over the fill, so it reads a shade darker than on the bordered variant. */
+.filled {
+  background: var(--ds-color-background-overlay-subtlest);
+}
