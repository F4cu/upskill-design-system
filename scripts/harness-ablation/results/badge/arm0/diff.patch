diff --git a/packages/components/src/components/Badge/index.tsx b/packages/components/src/components/Badge/index.tsx
new file mode 100644
index 0000000..5ff172f
--- /dev/null
+++ b/packages/components/src/components/Badge/index.tsx
@@ -0,0 +1,17 @@
+import type { HTMLAttributes } from 'react'
+import styles from './Badge.module.css'
+
+export type BadgeVariant = 'bordered' | 'filled'
+
+export type BadgeProps = {
+  variant?: BadgeVariant
+  children: React.ReactNode
+} & Omit<HTMLAttributes<HTMLSpanElement>, 'children'>
+
+export function Badge({ variant = 'bordered', children, className, ...rest }: BadgeProps) {
+  return (
+    <span className={[styles.badge, styles[variant], className].filter(Boolean).join(' ')} {...rest}>
+      {children}
+    </span>
+  )
+}
