+{
+  "component": {
+    "name": "CardVertical",
+    "category": "molecule",
+    "type": "display",
+    "status": "beta",
+    "description": "A vertical course card (image-top layout) for course catalogs and carousels. Top to bottom: a full-width thumbnail (Image), an optional ProgressBar, the course title (Heading headline-serif, wraps), and a meta row (Inline gap sm) with optional duration, a Certified marker and a Completed marker. Lifecycle is derived from progress (ADR-025): omitted → not started, 0–99 → in progress (bar), ≥100 → completed (full bar + Completed marker); the derived value is exposed as data-status on the root for tests and page-level styling. Two sizes: sm (180px thumbnail, saved-courses carousel) and lg (340px thumbnail, catalog grid). A single component configured by props — no parts. For compact list rows use CardHorizontal; for generic surfaces use Card."
+  },
+  "usage": {
+    "keywords": [
+      "card",
+      "course card",
+      "vertical card",
+      "catalog card",
+      "carousel card",
+      "saved courses"
+    ],
+    "when": [
+      "Displaying courses in a catalog grid (size lg)",
+      "Displaying saved or recommended courses in a horizontal carousel (size sm)",
+      "Showing a learner's progress or completion on a course tile"
+    ],
+    "patterns": [
+      {
+        "name": "catalog-grid",
+        "description": "Course catalog: a .grid of large cards; each grid cell sets the card width.",
+        "tree": "Box(className=grid) > [CardVertical(size=lg, title, thumbnailSrc, duration), CardVertical(size=lg, title, thumbnailSrc, duration, progress=40), ...]"
+      },
+      {
+        "name": "saved-courses-carousel",
+        "description": "Saved courses: small cards in a horizontal ScrollArea; the wrapping item fixes the card width.",
+        "tree": "ScrollArea(orientation=horizontal) > Inline(gap=md, wrap=false, align=start) > [CardVertical(size=sm, title, thumbnailSrc, duration, progress), ...]"
+      }
+    ],
+    "antiPatterns": [
+      {
+        "scenario": "Nesting CardVertical inside Card",
+        "reason": "Creates doubled surface depth that loses hierarchy meaning.",
+        "alternative": "Place CardVertical directly in a grid, Inline or ScrollArea."
+      },
+      {
+        "scenario": "Mixing sm and lg CardVertical, or CardVertical and CardHorizontal, in the same row or grid",
+        "reason": "Different thumbnail heights and layout directions break the visual rhythm of a list or grid.",
+        "alternative": "Pick one size per section: lg for catalog grids, sm for saved-courses carousels."
+      },
+      {
+        "scenario": "Asking for a status, completed or started prop to drive the lifecycle look",
+        "reason": "Lifecycle is derived from progress (ADR-025); a separate flag allows impossible combinations.",
+        "alternative": "Pass progress (0–100). Omit it for a course not started; 100 shows the full bar plus the Completed marker."
+      },
+      {
+        "scenario": "Packing extra data into duration, e.g. duration=\"12 Hours · Certified\"",
+        "reason": "One prop per datum; the component renders the Certified marker with its icon and owns spacing between meta items.",
+        "alternative": "Pass duration=\"12 Hours\" certified."
+      },
+      {
+        "scenario": "Setting a colour on the marker Icon or an inline colour on the card",
+        "reason": "Icon inherits currentColor; the card's CSS Module sets color.icon.subtle on the .marker ancestor, and Text owns its colour through color=\"subtle\".",
+        "alternative": "Leave marker colouring to CardVertical; restyle only through tokens."
+      },
+      {
+        "scenario": "Placing CardVertical under a heading that is not one level above its title",
+        "reason": "The title renders as headingLevel (default h3); a mismatch skips or inverts a level in the document outline.",
+        "alternative": "Set headingLevel to one below the enclosing section heading (h3 under an h2)."
+      },
+      {
+        "scenario": "Wrapping CardVertical in an anchor or adding onClick to make the whole card a link",
+        "reason": "The card is a display article with no interactive contract; a clickable div has no keyboard support and a wrapping link reads the whole card as the link name.",
+        "alternative": "Navigation affordances belong to the page layout (e.g. a TextLink beside the grid) until the card gains a link prop through a component change."
+      }
+    ]
+  },
+  "variants": {
+    "size": {
+      "options": [
+        "sm",
+        "lg"
+      ],
+      "default": "lg",
+      "purpose": {
