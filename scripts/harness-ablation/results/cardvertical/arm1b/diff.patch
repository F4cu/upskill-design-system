+{
+  "component": {
+    "name": "CardVertical",
+    "category": "molecule",
+    "type": "display",
+    "status": "beta",
+    "description": "A vertical course card (image-top layout): thumbnail, optional ProgressBar under it (stack sm), then a serif title and a meta row (Inline gap md) with optional duration, Certified marker and Completed marker. Completion is derived from progress (progress >= 100 renders the full bar plus a Completed marker). Two sizes: sm (3:2 thumbnail, card-min-sm) for saved-courses carousels, lg (4:5 thumbnail, card-min-lg) for catalog grids. For compact thumbnail-left lists use CardHorizontal; for generic surfaces use Card."
+  },
+  "usage": {
+    "keywords": [
+      "card",
+      "course card",
+      "vertical card",
+      "catalog",
+      "carousel",
+      "saved courses"
+    ],
+    "when": [
+      "Displaying courses in a catalog grid (size lg)",
+      "Displaying saved or started courses in a horizontal carousel (size sm)"
+    ],
+    "patterns": [
+      {
+        "name": "catalog-grid",
+        "description": "Catalog of courses in a responsive grid; each card fills its column.",
+        "tree": "Box(className=grid) > [CardVertical(size=lg, title, duration), CardVertical(size=lg, title, duration, progress=40), ...]"
+      },
+      {
+        "name": "saved-courses-carousel",
+        "description": "Horizontally scrollable row of small cards; each card sits at its min width.",
+        "tree": "ScrollArea(orientation=horizontal) > Inline(gap=md, wrap=false, align=start, style={width:'max-content'}) > [CardVertical(size=sm, ...), ...]"
+      }
+    ],
+    "antiPatterns": [
+      {
+        "scenario": "Adding a completed/status flag alongside progress",
+        "reason": "Lifecycle is derived from data (ADR-025): progress omitted = not started, 0–99 = in progress, 100 = completed.",
+        "alternative": "Pass progress={100} for a finished course."
+      },
+      {
+        "scenario": "Packing certification or completion text into duration, e.g. duration=\"12 Hours · Certified\"",
+        "reason": "One prop per datum; the component renders markers and spacing itself.",
+        "alternative": "Pass duration=\"12 Hours\" certified."
+      },
+      {
+        "scenario": "Mixing sizes or mixing CardVertical with CardHorizontal in the same row",
+        "reason": "Different thumbnail ratios break the row's visual rhythm.",
+        "alternative": "Use one size per section: sm in carousels, lg in catalog grids."
+      },
+      {
+        "scenario": "Setting a color on the marker Icons directly",
+        "reason": "Icons inherit currentColor; the card's CSS Module sets color.icon.subtle on the marker wrapper.",
+        "alternative": "Leave marker colouring to the component."
+      }
+    ]
+  },
