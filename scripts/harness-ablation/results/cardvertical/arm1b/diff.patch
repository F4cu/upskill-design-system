+      "size.card.min.lg"
+    ]
+  },
+  "accessibility": {
+    "role": "article",
+    "ariaAttributes": [
+      "role=article on the root, aria-labelledby → the title Heading's id (useId); role, children, title and aria-labelledby are omitted from the props type",
+      "ProgressBar aria-labelledby → the title id",
+      "headingLevel sets the title element (default h3) to fit the surrounding outline"
