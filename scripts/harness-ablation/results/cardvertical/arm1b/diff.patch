+  argTypes: {
+    size: { control: 'radio', options: ['sm', 'lg'] },
+    progress: { control: { type: 'range', min: 0, max: 100, step: 1 } },
+    headingLevel: { control: 'select', options: ['h2', 'h3', 'h4', 'h5', 'h6'] },
