+        "sm": "Saved-courses carousel: 3:2 thumbnail, min width size.card.min.sm.",
+        "lg": "Catalog grid: 4:5 thumbnail, min width size.card.min.lg."
+      }
+    }
+  },
+  "states": [
+    {
+      "state": "notStarted",
+      "description": "progress omitted: no ProgressBar."
+    },
+    {
+      "state": "inProgress",
+      "description": "progress 0–99: ProgressBar under the thumbnail."
+    },
+    {
+      "state": "completed",
+      "description": "progress >= 100: full ProgressBar plus a Completed marker in the meta row."
+    },
+    {
+      "state": "noThumbnail",
+      "description": "thumbnailSrc omitted: Image renders its placeholder."
+    },
+    {
+      "state": "noMeta",
+      "description": "No duration, certified or completion: the meta row is not rendered."
+    }
+  ],
+  "tokens": {
