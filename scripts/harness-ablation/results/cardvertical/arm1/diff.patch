+.card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--ds-space-stack-sm);
+  min-width: 0;
+}
+
+.sm {
+  width: var(--ds-size-card-min-sm);
+  flex-shrink: 0;
+}
+
+.lg {
+  width: 100%;
+  min-width: var(--ds-size-card-min-lg);
+}
+
+/* Doubled to beat Heading's .title-small regardless of stylesheet order */
+.title.title {
+  font-family: var(--ds-font-family-headline-serif);
+  font-weight: var(--ds-font-weight-medium);
+  line-height: var(--ds-font-line-height-tight);
+  overflow-wrap: anywhere;
+}
+
+.marker {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--ds-space-inline-xs);
+}
+
+.marker svg {
+  color: var(--ds-color-icon-subtle);
+}
