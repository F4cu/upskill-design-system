{
  "component": "ProgressBar",
  "anatomy": [
    {
      "name": "Root",
      "element": "div",
      "role": "progressbar",
      "required": true
    },
    {
      "name": "Fill",
      "element": "div",
      "role": "presentation",
      "required": true
    }
  ],
  "props": {
    "value": {
      "kind": "lifecycle",
      "type": "number",
      "default": null,
      "concept": "new term: the percentage the bar renders, 0 to 100; lifecycle states elsewhere derive from it (ADR-025)",
      "figma": {
        "surface": "both",
        "property": "Value"
      }
    },
    "label": {
      "kind": "content",
      "type": "string",
      "default": "Progress",
      "concept": "Accessible name",
      "figma": {
        "surface": "both",
        "property": "Label"
      }
    },
    "aria-labelledby": {
      "kind": "native",
      "type": "string",
      "default": null,
      "concept": "Accessible name",
      "figma": {
        "surface": "code-only"
      }
    }
  },
  "constraints": [],
  "states": [
    {
      "name": "default",
      "kind": "interaction",
      "trigger": "rest",
      "notes": "Static fill — no interactive states."
    }
  ],
  "accessibility": {
    "role": "progressbar",
    "ariaAttributes": [
      "aria-valuenow (set to the clamped value)",
      "aria-valuemin=0",
      "aria-valuemax=100",
      "aria-label (from the label prop, defaults to \"Progress\"); omitted when aria-labelledby is set",
      "aria-labelledby (alternative to label: id of a visible element that names the bar, e.g. a card title; the two props are mutually exclusive at the type level)"
    ],
    "keyboardInteractions": []
  },
  "styles": {
    "Root": [
      {
        "when": {},
        "set": {
          "width": {
            "literal": "100%",
            "reason": "Fills its container."
          },
          "height": "size.050",
          "background": "color.background.overlay.subtle",
          "border-radius": "border-radius.full"
        }
      }
    ],
    "Fill": [
      {
        "when": {},
        "set": {
          "height": {
            "literal": "100%",
            "reason": "Fills its container."
          },
          "width": {
            "literal": "0%",
            "reason": "Fallback for --_fill, which the value prop sets inline as a percentage."
          },
          "background": "color.background.progress",
          "border-radius": "border-radius.full"
        }
      }
    ]
  },
