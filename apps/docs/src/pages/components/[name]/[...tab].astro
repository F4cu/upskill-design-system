---
// Component pages (ADR-030, Phase A1): Usage, Spec, Tokens and Accessibility per
// component, rendered from specs.bundle.json. Every row traces to a field in
// the spec or <Name>.usage.json; a section with no data shows "None recorded".
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ComponentTabs from "../../../components/ComponentTabs.astro";
import AnatomyOverlay from "../../../components/AnatomyOverlay.tsx";
import LiveExample from "../../../components/LiveExample.tsx";
import VariantOverview from "../../../components/VariantOverview.tsx";
import Placement from "../../../components/Placement.tsx";
import AccessibilityFigure from "../../../components/AccessibilityFigure.tsx";
import { hasStory, pascal } from "../../../components/stories.tsx";
import {
  FIGMA_FILE,
  REPO_BLOB,
  STORYBOOK,
  TABS,
  bundle,
  familyOf,
  FEATURED_PATTERNS,
  pageHref,
  publishedComponents,
  slugOf,
} from "../../../../components.mjs";

export function getStaticPaths() {
  return publishedComponents().flatMap((name) =>
    TABS.map((tab) => ({
      params: { name: slugOf(name), tab: tab.path ? tab.path.replace(/\/$/, "") : undefined },
      props: { name, tabId: tab.id },
    })),
  );
}

const { name, tabId } = Astro.props;
const { spec, usage, a11y } = bundle.components[name];
const published = new Set(publishedComponents());

// "ADR-024" → its page on this site, or null when no published ADR has that number.
const adrIds = (await getCollection("docs")).map((e) => e.id).filter((id) => id.startsWith("decisions/"));
const adrHref = (ref) => {
  const num = /^ADR-(\d{3})$/.exec(ref)?.[1];
  const id = num && adrIds.find((i) => i.startsWith(`decisions/${num}-`));
  return id ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${id}/` : null;
};
const componentHref = (n) => (published.has(n) ? pageHref(n) : null);

const NONE = "None recorded.";

// --- formatting ---------------------------------------------------------
const formatWhen = (when) => {
  const entries = Object.entries(when);
  if (!entries.length) return "Default";
  return entries.map(([k, v]) => (v === "*" ? `${k} set` : `${k}=${v}`)).join(", ");
};

// Anatomy in depth-first order with each part's nesting depth.
const anatomy = (() => {
  const children = new Map();
  for (const part of spec.anatomy) {
    const key = part.parent ?? null;
    children.set(key, [...(children.get(key) ?? []), part]);
  }
  const out = [];
  const walk = (parent, depth) => {
    for (const part of children.get(parent) ?? []) {
      out.push({ ...part, depth });
      walk(part.name, depth + 1);
    }
  };
  walk(null, 0);
  return out;
})();

// Styles grouped under the parts the anatomy overview labels: each styled
// part rolls up to its nearest marked ancestor. A part built on a popover
// component is only positioned here; its tokens belong to that component.
const POPOVERS = new Set(["DropdownMenu"]);
// A style rule's `when`: empty is Default, `state` an interaction or
// ARIA-driven state, any other key a prop value. Rows run in that order.
const stateRank = (when) => (!Object.keys(when).length ? 0 : "state" in when ? 2 : 1);
const stateLabel = (when) => {
  const entries = Object.entries(when);
  if (!entries.length) return [{ text: "Default" }];
  return entries.map(([k, v]) => (k === "state" ? { text: v } : { code: v === "*" ? k : `${k}="${v}"` }));
};
const styleGroups = (() => {
  const byName = new Map(spec.anatomy.map((p) => [p.name, p]));
  // Same parts as AnatomyOverlay labels: an example without `mark` labels every
  // renderable part.
  const renderable = spec.anatomy.filter((p) => !p.notRendered).map((p) => p.name);
  const overview = [...new Set((spec.anatomyExamples ?? []).filter((e) => !e.focus).flatMap((e) => e.mark ?? renderable))]
    .sort((a, b) => renderable.indexOf(a) - renderable.indexOf(b));
  const groupOf = (n) => {
    for (let p = byName.get(n); p; p = byName.get(p.parent)) if (overview.includes(p.name)) return p.name;
    return n;
  };
  const tokensIn = (value) => {
    if (typeof value === "string") return [{ token: value }];
    if (value.literal !== undefined) return [{ literal: value.literal, reason: value.reason }];
    if (value.sameAs) return [];
    return [...value.template.matchAll(/\{([a-z0-9.-]+)\}/g)].map((m) => ({ token: m[1] }));
  };
  // What a part's builtOn component sets for the props the part passes it
  // (builtOnProps), minus any property the part's own default rule overrides.
  // A mapped prop ({ from, map, otherwise }, ADR-027 amendment 2026-11-11)
  // resolves to `otherwise` for the Default row, and to each `map` value for a
  // row under that value of this component's prop, listing only what changes.
  const inherited = (part) => {
    const builtOn = byName.get(part)?.builtOn;
    const props = byName.get(part)?.builtOnProps;
    const rules = builtOn && builtOn !== name && props && bundle.components[builtOn]?.spec.styles?.Root;
    if (!rules) return [];
    const own = (spec.styles[part] ?? []).find((r) => !Object.keys(r.when).length)?.set ?? {};
    const resolve = (childProps) => {
      const set = {};
      const via = {};
      for (const r of rules) {
        const entries = Object.entries(r.when);
        if (!entries.length || !entries.every(([k, v]) => (v === "*" ? childProps[k] !== undefined : childProps[k] === v))) continue;
        for (const [prop, value] of Object.entries(r.set)) {
          set[prop] = value;
          via[prop] = `${builtOn} ${entries.map(([k, v]) => (v === "*" ? k : `${k}="${v}"`)).join(" ")}`;
        }
      }
      return Object.fromEntries(Object.entries(set).filter(([prop]) => !(prop in own)).map(([prop, value]) => [prop, { value, via: via[prop] }]));
    };
    const base = Object.fromEntries(Object.entries(props).map(([k, v]) => [k, typeof v === "object" ? v.otherwise : v]));
    const baseSet = resolve(base);
    const out = Object.values(baseSet).map((e) => ({ when: {}, ...e }));
    for (const [k, v] of Object.entries(props)) {
      if (typeof v !== "object") continue;
      for (const [parentValue, childValue] of Object.entries(v.map)) {
        const changed = Object.entries(resolve({ ...base, [k]: childValue }))
          .filter(([prop, e]) => JSON.stringify(baseSet[prop]?.value) !== JSON.stringify(e.value));
        out.push(...changed.map(([, e]) => ({ when: { [v.from]: parentValue }, ...e })));
      }
    }
    return out;
  };
  // A prop that crosses `state` in two or more of a part's rules (Button's
  // variant × hover/active/disabled) splits the part: one subgroup per value,
  // whose rows then read Default, hover, active… without repeating the prop.
  const splitAxis = (rules) => {
    const counts = {};
    for (const r of rules) if ("state" in r.when) for (const k of Object.keys(r.when)) if (k !== "state") counts[k] = (counts[k] ?? 0) + 1;
    return Object.entries(counts).sort(([, a], [, b]) => b - a).find(([, n]) => n >= 2)?.[0];
  };
  const SUB = "\u0000";
  // "accentInverted" → "Accent inverted", for subgroup headers like "Variant: Accent".
  const words = (s) => String(s).replace(/([a-z])([A-Z])/g, "$1 $2").toLowerCase().replace(/^./, (c) => c.toUpperCase());
  const groups = new Map();
  const add = (group, when, entries) => {
    const conditions = groups.get(group) ?? new Map();
    const list = conditions.get(when) ?? [];
    for (const e of entries) if (!list.some((x) => x.token === e.token && x.literal === e.literal)) list.push(e);
    conditions.set(when, list);
    groups.set(group, conditions);
  };
  for (const part of new Set([...spec.anatomy.map((p) => p.name), ...Object.keys(spec.styles)])) {
    if (POPOVERS.has(byName.get(part)?.builtOn)) continue;
    const group = groupOf(part);
    const rules = spec.styles[part] ?? [];
    const axis = splitAxis(rules);
    add(group, "{}", []);
    for (const rule of rules) {
      const { [axis]: value, ...rest } = rule.when;
      const sub = axis && value !== undefined ? `${group}${SUB}${value === "*" ? words(axis) : `${words(axis)}: ${words(value)}`}` : group;
      add(sub, JSON.stringify(sub === group ? rule.when : rest), Object.values(rule.set).flatMap(tokensIn));
    }
    for (const { when, value, via } of inherited(part)) add(group, JSON.stringify(when), tokensIn(value).map((e) => ({ ...e, via })));
  }
  // Every labelled part keeps its group, so the groups match the diagram; a
  // part with no tokens of its own says where its look comes from instead.
  for (const part of overview) if (!groups.has(part)) groups.set(part, new Map());
  const noteFor = (part) => {
    const p = byName.get(part);
    if (p?.builtOn && p.builtOn !== name) return { text: "Styled by", component: p.builtOn, href: componentHref(p.builtOn) };
    return { text: `No tokens of its own; inherits from ${p?.parent ?? spec.anatomy[0].name}.` };
  };
  const order = (key) => {
    const n = key.split(SUB)[0];
    return overview.includes(n) ? overview.indexOf(n) : overview.length;
  };
  return [...groups]
    .sort(([a], [b]) => order(a) - order(b))
    .map(([key, conditions]) => ({
      group: key.split(SUB)[0],
      sub: key.split(SUB)[1],
      note: overview.includes(key) && ![...conditions.values()].some((e) => e.length) ? noteFor(key) : null,
      conditions: [...conditions].filter(([, e]) => e.length)
        .map(([w, entries]) => [JSON.parse(w), entries.map((e) => ({
          ...e,
          className: [e.literal !== undefined && "literal", e.via && "inherited"].filter(Boolean).join(" ") || undefined,
          title: [e.via && `From ${e.via}`, e.reason].filter(Boolean).join(". ") || undefined,
        }))])
        .sort(([a], [b]) => stateRank(a) - stateRank(b)),
    }))
    .filter((g) => g.conditions.length || g.note);
})();

// Spec props keyed '<Part>.<prop>' belong to an ADR-023 part, not the preset.
const rootProps = Object.entries(spec.props).filter(([key]) => !key.includes("."));
const partProps = [...Object.entries(spec.props).filter(([key]) => key.includes(".")).reduce((groups, [key, p]) => {
  const [part, prop] = key.split(".");
  return groups.set(part, [...(groups.get(part) ?? []), [prop, p]]);
}, new Map())];
// A slot prop's TypeScript type (ReactElement<CardVerticalFavoriteProps | …>)
// reads as "element", with the parts it accepts as its options.
const elementOf = (type) => {
  const m = /^ReactElement<(.+)>$/.exec(type ?? "");
  if (!m) return null;
  return m[1].split("|").map((t) => {
    const props = t.trim().replace(/Props$/, "");
    const part = props.startsWith(name) ? props.slice(name.length) : "";
    return part ? `${name}.${part}` : props;
  });
};
// A prop with a fixed set of values reads as "enum"; the values are its options.
const typeCell = (p) => (elementOf(p.type) ? "element" : p.options ? "enum" : p.type);
const optionsOf = (p) => p.options ?? elementOf(p.type);
const defaultCell = (p) => (p.default === null || p.default === undefined ? "—" : JSON.stringify(p.default));
const codeOnlyVariant = (axis) => spec.props[axis]?.figma?.surface === "code-only";
const focusState = spec.states.find((s) => s.name === "focus-visible");

// Live examples render stories by name (ADR-030 Phase A2): the Usage example
// is the Default story, a pattern is its PascalCase export in
// <Name>.patterns.stories.tsx, and a state is its PascalCase export in
// <Name>.stories.tsx (rest → Default). Interaction states are pseudo-classes,
// so they are shown on the live Default example rather than forced.
const hasDefault = hasStory(name, "stories", "Default");
const stateStory = (s) => (s.trigger === "rest" ? "Default" : pascal(s.name));
const stateExample = (s) => {
  if (s.trigger === "rest") return hasDefault ? "rendered" : "missing";
  if (s.kind === "interaction") return "interaction";
  return hasStory(name, "stories", stateStory(s)) ? "rendered" : "missing";
};
// The States section tiles only the states a reader can't see elsewhere:
// lifecycle, content and app data, each from its story (or the gap where one
// is missing). Rest is the Usage example; interaction states (pseudo-classes)
// are left to the live examples. The caption is two tags: the kind as a
// readable label, then the state's spec name as code.
const shownStates = (spec.states ?? []).filter((s) => ["lifecycle", "content", "appData"].includes(s.kind));
const KIND = { interaction: "Interaction", appData: "App data", lifecycle: "Lifecycle", content: "Content" };

const LIMIT_SCOPE = { region: "region (section)", repeated: "repeated item", parent: "parent" };
// Usage (prototype): each variant axis opens the page as its own section, an
// overview of its options then their use-when table. No axes → one example.
const axes = Object.entries(usage.variants ?? {});
const AXIS_TITLES = { variant: "Variants", size: "Sizing", shape: "Shape", orientation: "Orientation" };
const axisTitle = (axis) => AXIS_TITLES[axis] ?? axis.charAt(0).toUpperCase() + axis.slice(1);
const axisSlug = (axis) => axisTitle(axis).toLowerCase();
const WIDTH = { fill: "Fills its container", hug: "Hugs its content", fixed: "Keeps its own fixed size" };
const builtFrom = [...new Set((spec.anatomy ?? []).map((part) => part.builtOn).filter((n) => n && n !== name))].sort();

// Placement (prototype): a component with a placement file shows Do / Don't
// boxes in place of Patterns, Not for, Composition, Prop rules and Related
// components; the variant sections and the boxes cover them.
const placementFiles = import.meta.glob("../../../placement/*.tsx", { eager: true });
const placement = placementFiles[`../../../placement/${name}.tsx`]?.placement;
// Accessibility (prototype): a component with a file in accessibility/ shows
// use cases, reading order and names, and keyboard advice, each with a figure, in place of the
// spec's full contract (role, ARIA, key table, testing), which stays in
// spec.json.
const accessibilityFiles = import.meta.glob("../../../accessibility/*.tsx", { eager: true });
const a11yGuide = accessibilityFiles[`../../../accessibility/${name}.tsx`]?.accessibility;
// Patterns: every usage pattern, or only the featured ones when the component
// lists them (with their arg overrides).
const shownPatterns = (usage.composition?.patterns ?? [])
  .filter((p) => !FEATURED_PATTERNS[name] || FEATURED_PATTERNS[name].some((f) => f.pattern === p.name))
  .map((p) => {
    const featured = FEATURED_PATTERNS[name]?.find((f) => f.pattern === p.name);
    return { ...p, args: featured?.args, wide: featured?.wide };
  });
// "When to use it" only for a family of lookalikes, opening with the choice.
const family = familyOf(name);

const storybookId = `components-${name.toLowerCase()}`;
const links = [
  { label: "Storybook", href: `${STORYBOOK}?path=/docs/${storybookId}--docs` },
  ...spec.figma.sets.map((set) => ({
    label: spec.figma.sets.length > 1 ? `Figma: ${set.name}` : "Figma",
    href: `${FIGMA_FILE}?node-id=${set.nodeId.replace(":", "-")}`,
  })),
  { label: "Spec source", href: `${REPO_BLOB}/packages/components/src/components/${name}/${name}.spec.json` },
  { label: "Usage source", href: `${REPO_BLOB}/packages/components/src/components/${name}/${name}.usage.json` },
];

const HEADINGS = {
  usage: [
    ...(axes.length ? axes.map(([axis]) => [axisSlug(axis), axisTitle(axis)]) : [["example", "Example"]]),
    ...(family ? [["when-to-use", "When to use it"]] : []),
    ...(placement
      ? [["composition", "Composition"]]
      : [
          ["patterns", "Patterns"],
          ["not-for", "Not for"],
          ["composition", "Composition"],
          ["rules", "Prop rules"],
          ["related", "Related components"],
        ]),
  ],
  spec: [
    ["anatomy", "Anatomy"],
    ["props", "Props"],
    ["states", "States"],
    ["why", "Why it's built this way"],
    ["parity", "Design–code parity"],
  ],
  tokens: [["styles", "Token usage"]],
  accessibility: a11yGuide
    ? [
        ["use-cases", "Use cases"],
        ["reading-order", "Reading order and names"],
        ["keyboard", "Keyboard and focus"],
      ]
    : [
        ["role", "Role and ARIA"],
        ["keyboard", "Keyboard"],
        ["focus", "Focus"],
        ["testing", "Testing"],
      ],
};
const headings = HEADINGS[tabId].map(([slug, text]) => ({ depth: 2, slug, text }));
const h = Object.fromEntries(HEADINGS[tabId]);

const FONTS =
  "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Roboto:wght@400;500;600;700&family=Roboto+Mono:wght@400&display=swap";
const SITE_WIDE_ADRS = ["ADR-025", "ADR-026", "ADR-028"];
---

<StarlightPage
  frontmatter={{
    title: name,
    description: usage.component.description,
    ...(tabId !== "usage" && { prev: false, next: false }),
    // The brand fonts the rendered examples use, as in Storybook's preview-head.html
    head: [
      { tag: "link", attrs: { rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "" } },
      { tag: "link", attrs: { rel: "stylesheet", href: FONTS } },
    ],
  }}
  headings={headings}
>
  <div class="component-header">
    <p>{usage.component.description}</p>
    <dl class="component-meta">
      <dt>Maturity</dt>
      <dd><code>{usage.component.status}</code></dd>
      <dt>Links</dt>
      <dd>{links.map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</dd>
    </dl>
  </div>

  <ComponentTabs name={name} current={tabId} />

  {
    tabId === "usage" && (
      <>
        {axes.length ? (
          axes.map(([axis, v]) => (
            <>
              <h2 id={axisSlug(axis)}>{axisTitle(axis)}</h2>
              {codeOnlyVariant(axis) && <p class="note">Only available in code.</p>}
              {hasDefault && (
                <div class="not-content">
                  <VariantOverview client:visible name={name} axis={axis} options={v.options} constraints={spec.constraints ?? []} />
                </div>
              )}
              <table>
                <thead><tr><th scope="col">Option</th><th scope="col">Use when</th></tr></thead>
                <tbody>
                  {v.options.map((opt) => (
                    <tr>
                      <td><code>{opt}</code>{opt === v.default && " (default)"}</td>
                      <td>{v.useWhen?.[opt] ?? NONE}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          ))
        ) : (
          <>
            <h2 id="example">Example</h2>
            {hasDefault ? (
              <div class="not-content"><LiveExample client:visible name={name} file="stories" exportName="Default" /></div>
            ) : (
              <p>No <code>Default</code> story, so no live example.</p>
            )}
          </>
        )}

        {family && (
          <>
            <h2 id="when-to-use">{h["when-to-use"]}</h2>
            <p>
              Choose between {family.map((n, i) => (
                <>{i > 0 && (i === family.length - 1 ? " and " : ", ")}{n === name ? <strong>{n}</strong> : componentHref(n) ? <a href={componentHref(n)}>{n}</a> : n}</>
              ))}. Use {name} when:
            </p>
            {usage.useWhen?.length ? <ul>{usage.useWhen.map((w) => <li>{w}</li>)}</ul> : <p>{NONE}</p>}
          </>
        )}

        {placement && (
          <>
            <h2 id="composition">{h.composition}</h2>
            <div class="not-content"><Placement client:visible name={name} /></div>
          </>
        )}

        {!placement && <>
        <h2 id="patterns">{h.patterns}</h2>
        {shownPatterns.length ? (
          <div class="pattern-grid not-content">
            {shownPatterns.map((p) => (
              <figure class:list={["pattern-card", { "is-wide": p.wide }]}>
                {hasStory(name, "patterns.stories", pascal(p.name)) ? (
                  <LiveExample client:visible name={name} file="patterns.stories" exportName={pascal(p.name)} args={p.args} />
                ) : (
                  <div class="state-missing">No <code>{pascal(p.name)}</code> story</div>
                )}
                <figcaption><code>{p.name}</code> {p.useWhen}</figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="not-for">{h["not-for"]}</h2>
        {usage.notFor?.length ? (
          <table>
            <thead><tr><th scope="col">Not for</th><th scope="col">Why</th><th scope="col">Use instead</th></tr></thead>
            <tbody>
              {usage.notFor.map((n) => (
                <tr>
                  <td>{n.case}</td>
                  <td>{n.because}</td>
                  <td>
                    {n.instead && (componentHref(n.instead) ? <a href={componentHref(n.instead)}>{n.instead}</a> : n.instead)}
                    {n.instead && n.note && <br />}
                    {n.note}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="composition">{h.composition}</h2>
        {usage.composition?.limits?.length || usage.composition?.donts?.length ? (
          <>
            {usage.composition.limits?.length > 0 && (
              <table>
                <thead><tr><th scope="col">Limit</th><th scope="col">Why</th></tr></thead>
                <tbody>
                  {usage.composition.limits.map((l) => (
                    <tr>
                      <td>{formatWhen(l.if)}: {l.max === 0 ? `never inside a ${LIMIT_SCOPE[l.per]}` : `at most ${l.max} per ${LIMIT_SCOPE[l.per]}`}</td>
                      <td>{l.because}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {usage.composition.donts?.length > 0 && (
              <table>
                <thead><tr><th scope="col">Don't</th><th scope="col">Why</th><th scope="col">Instead</th></tr></thead>
                <tbody>
                  {usage.composition.donts.map((r) => (
                    <tr><td>{r.case}</td><td>{r.because}</td><td>{r.instead}</td></tr>
                  ))}
                </tbody>
              </table>
            )}
          </>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="rules">{h.rules}</h2>
        {spec.constraints?.length ? (
          <table>
            <thead><tr><th scope="col">Rule</th><th scope="col">When</th><th scope="col">Why</th><th scope="col">Enforced by</th></tr></thead>
            <tbody>
              {spec.constraints.map((c) => (
                <tr>
                  <td><code>{c.id}</code></td>
                  <td>
                    {formatWhen(c.if)}
                    {[["requires", c.require], ["ignores", c.ignore]].filter(([, list]) => list?.length).map(([verb, list]) => (
                      <><br />{verb} {list.map((r, i) => <>{i > 0 && ", "}<code>{r}</code></>)}</>
                    ))}
                  </td>
                  <td>{c.reason}</td>
                  <td>{c.enforcedBy?.join(", ")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="related">{h.related}</h2>
        <dl class="related">
          {[["Built from", builtFrom], ["Placed inside", usage.composition?.containedBy]].map(([label, list]) => (
            <>
              <dt>{label}</dt>
              <dd>
                {list?.length
                  ? list.map((n, i) => <>{i > 0 && ", "}{componentHref(n) ? <a href={componentHref(n)}>{n}</a> : n}</>)
                  : NONE}
              </dd>
            </>
          ))}
          <dt>Width</dt>
          <dd>{WIDTH[usage.composition?.width] ?? NONE}</dd>
        </dl>
        </>}
      </>
    )
  }

  {
    tabId === "spec" && (
      <>
        <h2 id="anatomy">{h.anatomy}</h2>
        {spec.anatomyExamples?.length ? (
          <div class="not-content">
            <AnatomyOverlay client:visible name={name} parts={anatomy} examples={spec.anatomyExamples} variants={Object.fromEntries(Object.entries(usage.variants ?? {}).map(([axis, v]) => [axis, v.default]))} />
          </div>
        ) : (
          <p>No anatomy examples recorded, so no diagram.</p>
        )}

        <h2 id="props">{h.props}</h2>
        <table class="props-table">
          <thead><tr><th scope="col">Prop</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Options</th></tr></thead>
          <tbody>
            {rootProps.map(([prop, p]) => (
              <tr>
                <th scope="row"><code>{prop}</code></th>
                <td><code>{typeCell(p)}</code></td>
                <td>{defaultCell(p) === "—" ? "—" : <code>{defaultCell(p)}</code>}</td>
                <td>{optionsOf(p) ? <span class="options">{optionsOf(p).map((o) => <code>{o}</code>)}</span> : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {partProps.length > 0 && (
          <>
            <h3 id="composition-props">Composition props</h3>
            <p>Props of <code>{name}.Root</code> and its parts, for building the component from parts instead of the preset (<a href={adrHref("ADR-023")}>ADR-023</a>).</p>
            <details class="composition-props">
              <summary>Show {partProps.reduce((n, [, props]) => n + props.length, 0)} props on {partProps.length} parts</summary>
            <table class="props-table part-props">
              <thead><tr><th scope="col">Part</th><th scope="col">Prop</th><th scope="col">Default</th><th scope="col">Options</th></tr></thead>
              <tbody>
                {partProps.map(([part, props]) =>
                  props.map(([prop, p], i) => (
                    <tr>
                      {i === 0 && <th scope="rowgroup" rowspan={props.length}><code>{name}.{part}</code></th>}
                      <th scope="row"><code>{prop}</code></th>
                      <td>{defaultCell(p) === "—" ? "—" : <code>{defaultCell(p)}</code>}</td>
                      <td>{optionsOf(p) ? <span class="options">{optionsOf(p).map((o) => <code>{o}</code>)}</span> : "—"}</td>
                    </tr>
                  )),
                )}
              </tbody>
            </table>
            </details>
          </>
        )}

        <h2 id="states">{h.states}</h2>
        {spec.states?.length ? (
          <>
          <div class="state-grid not-content">
            {shownStates.map((s) => (
              <figure class="state">
                {stateExample(s) === "rendered" ? (
                  <LiveExample client:visible name={name} file="stories" exportName={stateStory(s)} />
                ) : (
                  <div class="state-missing">No <code>{stateStory(s)}</code> story</div>
                )}
                <figcaption class="anatomy-caption caption-tags">
                  <span class="caption-tag">{KIND[s.kind]}</span>
                  <code>{s.name}</code>
                </figcaption>
              </figure>
            ))}
          </div>
          </>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="why">{h.why}</h2>
        <h3>Decisions</h3>
        {spec.decisions?.length ? (
          <ul>
            {spec.decisions.map((d) => (
              <li>
                {d.decision}
                {d.reason && <> <em>{d.reason}</em></>}
                {d.adr && <> ({adrHref(d.adr) ? <a href={adrHref(d.adr)}>{d.adr}</a> : d.adr})</>}
              </li>
            ))}
          </ul>
        ) : (
          <p>{NONE}</p>
        )}
        <h3>Ruled out</h3>
        {spec.ruledOut?.length ? (
          <table>
            <thead><tr><th scope="col">Option</th><th scope="col">Why not</th><th scope="col">Seen in</th></tr></thead>
            <tbody>
              {spec.ruledOut.map((r) => <tr><td>{r.option}</td><td>{r.reason}</td><td>{r.source ?? ""}</td></tr>)}
            </tbody>
          </table>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="parity">{h.parity}</h2>
        {spec.figma.divergences?.length ? (
          <ul>{spec.figma.divergences.map((d) => <li>{d.what} <em>{d.decision}</em></li>)}</ul>
        ) : (
          <p>{NONE}</p>
        )}
      </>
    )
  }

  {
    tabId === "tokens" && (
      <>
        <h2 id="styles">{h.styles}</h2>
        <p>The tokens each part uses, grouped by the parts labelled on the <a href={`${pageHref(name, TABS.find((t) => t.id === "spec"))}#anatomy`}>anatomy diagram</a>, one row per state (<a href={adrHref("ADR-025")}>ADR-025</a>): <strong>Default</strong> always applies, a prop value such as <code>size="lg"</code> is set by the consumer, and the rest are interaction or ARIA-driven states. Only Root starts expanded; select a part to expand or collapse it.</p>
        <table class="styles-table">
          <thead><tr><th scope="col">State</th><th scope="col">Tokens</th></tr></thead>
          {styleGroups.map(({ group, sub, note, conditions }) => (
            <tbody class:list={{ "is-collapsed": group !== "Root" }}>
              <tr class="part-row">
                <th scope="rowgroup" colspan="2">
                  <button type="button" class="part-toggle" aria-expanded={String(group === "Root")}>
                    <span class="part-chevron" aria-hidden="true"></span>
                    {sub ? <><span class="sr-only">{group}, </span>{sub}</> : group}
                  </button>
                </th>
              </tr>
              {note && (
                <tr>
                  <td colspan="2" class="group-note">
                    {note.text}{note.component && <> {note.href ? <a href={note.href}>{note.component}</a> : note.component}.</>}
                  </td>
                </tr>
              )}
              {conditions.map(([when, entries]) => (
                <tr>
                  <th scope="row" class="condition">{stateLabel(when).map((l, i) => <>{i > 0 && " + "}{l.code ? <code>{l.code}</code> : l.text}</>)}</th>
                  <td>
                    <span class="options">
                      {entries.map((e) => <code class={e.className} title={e.title}>{e.token ?? e.literal}</code>)}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
        <dl class="styles-legend">
          <div><dt><code>token.name</code></dt><dd>Token this component sets</dd></div>
          <div><dt><code class="inherited">token.name</code></dt><dd>Token from the component the part is built on; hover it for which</dd></div>
          <div><dt><code class="literal">value</code></dt><dd>Raw value with no token; hover it for the reason</dd></div>
        </dl>
      </>
    )
  }

  {
    tabId === "accessibility" && a11yGuide && (
      <>
        <h2 id="use-cases">{h["use-cases"]}</h2>
        <p>People using assistive technology should be able to:</p>
        <ul>{a11yGuide.useCases.map((u) => <li>{u}</li>)}</ul>

        <h2 id="reading-order">{h["reading-order"]}</h2>
        <p>{a11yGuide.labeling.advice}</p>
        <div class="not-content"><AccessibilityFigure client:visible name={name} figure="names" /></div>

        <h2 id="keyboard">{h.keyboard}</h2>
        <p>{a11yGuide.keyboard.advice}</p>
        <div class="not-content"><AccessibilityFigure client:visible name={name} figure="focus" /></div>
      </>
    )
  }

  {
    tabId === "accessibility" && !a11yGuide && (
      <>
        <h2 id="role">{h.role}</h2>
        <p>Role: <code>{spec.accessibility.role}</code></p>
        {spec.accessibility.ariaAttributes?.length ? (
          <ul>{spec.accessibility.ariaAttributes.map((a) => <li>{a}</li>)}</ul>
        ) : (
          <p>{NONE}</p>
        )}
        {spec.accessibility.notes && <p>{spec.accessibility.notes}</p>}

        <h2 id="keyboard">{h.keyboard}</h2>
        {spec.accessibility.keyboardInteractions?.length ? (
          <table>
            <thead><tr><th scope="col">Key</th><th scope="col">Action</th></tr></thead>
            <tbody>
              {spec.accessibility.keyboardInteractions.map((k) => <tr><th scope="row"><kbd>{k.key}</kbd></th><td>{k.action}</td></tr>)}
            </tbody>
          </table>
        ) : (
          <p>{NONE}</p>
        )}

        <h2 id="focus">{h.focus}</h2>
        <p>{focusState?.notes ?? NONE}</p>

        <h2 id="testing">{h.testing}</h2>
        <p>
          {a11y.tier === 2 ? (
            a11y.test ? (
              <>Tier 2 (<a href={adrHref("ADR-008")}>ADR-008</a>): interactive, covered by the behavioral test <a href={`${REPO_BLOB}/${a11y.test}`}><code>{a11y.test.split("/").pop()}</code></a> plus the Tier 1 lint.</>
            ) : (
              <>Tier 2 (<a href={adrHref("ADR-008")}>ADR-008</a>): interactive, but no behavioral test yet{a11y.backlog && " (waived in the a11y backlog)"}.</>
            )
          ) : (
            <>Tier 1 (<a href={adrHref("ADR-008")}>ADR-008</a>): not interactive, covered by the <code>jsx-a11y</code> lint only.</>
          )}{" "}
          Every story is also swept by axe.
        </p>
      </>
    )
  }

  <p class="site-wide">
    Every component follows {SITE_WIDE_ADRS.map((ref, i) => <>{i > 0 && (i === SITE_WIDE_ADRS.length - 1 ? " and " : ", ")}<a href={adrHref(ref)}>{ref}</a></>)}
    (states, prop vocabulary, focus indicator); they are not repeated per component.
  </p>
</StarlightPage>

<script>
  // Styles table: each part's subheader collapses the rows under it.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest(".part-toggle");
    if (!button) return;
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    button.closest("tbody")?.classList.toggle("is-collapsed", expanded);
  });
</script>

<style>
  .component-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-sm);
  }
  .component-meta dd {
    margin: 0;
  }
  .context,
  .note {
    color: var(--sl-color-gray-3);
  }
  .context {
    font-size: var(--sl-text-xs);
  }
  .state-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin-block: 1rem;
  }
  .state {
    margin: 0;
  }

  details summary {
    cursor: pointer;
  }
  .site-wide {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
